# 该 .dcp 是增量综合参考点,位于被 .gitignore 排除的 utils_1/ 下,干净 clone 里没有。
# 原版脚本无条件 add_files,于是复现时在此处以 ERROR 中断(Vivado 12-172)。
# 先判存在再挂,后续两段属性设置也一并圈进 if——否则 get_files 取到空对象会再报错。
set files [list \
 [file normalize "${origin_dir}/hdmi_loop.srcs/utils_1/imports/synth_1/hdmi_loop.dcp" ]\
]
if { [file exists [lindex $files 0]] } {
  set added_files [add_files -fileset utils_1 $files]

  # Set 'utils_1' fileset file properties for remote files
  # None

  # Set 'utils_1' fileset file properties for local files
  set file "synth_1/hdmi_loop.dcp"
  set file_obj [get_files -of_objects [get_filesets utils_1] [list "*$file"]]
  set_property -name "netlist_only" -value "0" -objects $file_obj
} else {
  puts "INFO: utils_1 增量参考点 [lindex $files 0] 不存在,已跳过该 fileset 的挂载。"
}


